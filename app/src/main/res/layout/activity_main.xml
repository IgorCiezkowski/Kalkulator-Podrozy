<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dystans w km"
        android:textSize="15sp"
        android:layout_marginTop="10dp"/>
    <EditText
        android:id="@+id/EtDist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zużycie paliwa na 100km"
        android:textSize="15sp"
        android:layout_marginTop="10dp"/>
    <EditText
        android:id="@+id/EtFuel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"/>
    <RadioGroup
        android:id="@+id/RgType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <RadioButton
            android:id="@+id/RbBen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Benzyna(6.50zł)"
            android:textSize="15sp"/>
        <RadioButton
            android:id="@+id/RbDis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diesel(6.70zł)"
            android:textSize="15sp"/>
        <RadioButton
            android:id="@+id/RbLpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LPG(3.10zł)"
            android:textSize="15sp"/>
    </RadioGroup>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Liczba pasażerów"
        android:textSize="15sp"
        android:layout_marginTop="10dp"/>
    <EditText
        android:id="@+id/EtPas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"/>
    <Button
        android:id="@+id/btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:text="OBLICZ KOSZT"
        android:layout_marginTop="10dp"/>
    <TextView
        android:id="@+id/TvCost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Całkowity koszt:"
        android:layout_marginTop="20dp"
        android:textSize="25sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textColor="#0b650c"/>
    <TextView
        android:id="@+id/TvPerPers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Na osobę:"
        android:layout_marginTop="10dp"
        android:textSize="25sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textColor="#0b650c"/>
</LinearLayout>